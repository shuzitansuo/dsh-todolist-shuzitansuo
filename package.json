{
  "name": "@local/dsh-calendar",
  "version": "0.3.1",
  "private": true,
  "description": "本地任务日历、番茄钟与工作总结：项目、任务分类与彩色复选框、重复任务、周/月/日视图、任务清单、看板视图、四象限、KISS 复盘、手写感想、每日 48 格时间带、子任务清单、番茄统计、可配置的日视图时间范围与 macOS 本机日历日程同步，Obsidian 今日任务与总结日志写入，数据保存在本机 SQLite",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "lib/CalendarSync.swift",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuzitansuo/dsh-todolist-shuzitansuo.git"
  },
  "homepage": "https://github.com/shuzitansuo/dsh-todolist-shuzitansuo#readme",
  "bugs": {
    "url": "https://github.com/shuzitansuo/dsh-todolist-shuzitansuo/issues"
  }
}
